{
    "name": "@itslucas_off/luna-park-custom-css",
    "version": "1.0.0",
    "description": "Custom CSS plugin for Luna Park.",
    "keywords": [
        "luna-park",
        "plugin",
        "css",
        "styles",
        "custom-css"
    ],
    "license": "MIT",
    "author": {
        "name": "ItsLucas-Official",
        "url": "https://github.com/ItsLucas-Official"
    },
    "homepage": "https://github.com/ItsLucas-Official/luna-park-plugin-custom-css#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ItsLucas-Official/luna-park-plugin-custom-css.git"
    },
    "bugs": {
        "url": "https://github.com/ItsLucas-Official/luna-park-plugin-custom-css/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./runtime": {
            "import": "./dist/runtime.js",
            "default": "./dist/runtime.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "preview": "luna-preview",
        "typecheck": "vue-tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build && node scripts/check-dist.mjs"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@lezer/highlight": "^1.2.5",
        "@luna-park/design": "^1.7.0",
        "@luna-park/eslint-config": "^1.4.5",
        "@luna-park/plugin": "^2.3.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-plugin-css-injected-by-js": "^5.0.3",
        "vue": "^3.5.45",
        "vue-tsc": "^3.3.14"
    },
    "peerDependencies": {
        "@luna-park/design": "^1.7.0",
        "vue": "^3.5.43"
    }
}
